# Copy this file to .env for local Docker Compose use. Do not commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=evidenceforge
POSTGRES_USER=evidenceforge
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://evidenceforge:replace-with-a-local-development-password@db:5432/evidenceforge

# Reserved for a future browser-to-API configuration seam. The Phase 1A UI does not call the API yet.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
