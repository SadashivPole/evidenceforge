# Copy this file to .env for local Docker Compose use. Do not commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=evidenceforge
POSTGRES_USER=evidenceforge
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://evidenceforge:replace-with-a-local-development-password@db:5432/evidenceforge

# Next.js server-side rewrite destination for /backend-api/*; use the Compose service name when running in Docker.
EVIDENCEFORGE_API_URL=http://api:8000
